{
  "name": "wb-admin",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "WB-Admin · 通用后台管理系统脚手架（Vue3 + TypeScript + Element Plus）",
  "keywords": [
    "vue3",
    "typescript",
    "vite",
    "element-plus",
    "admin",
    "admin-template",
    "backend-management",
    "scaffold",
    "pinia",
    "rbac",
    "multi-tenant"
  ],
  "author": "wbjf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wbjf/WB-Admin.git"
  },
  "homepage": "https://github.com/wbjf/WB-Admin#readme",
  "bugs": {
    "url": "https://github.com/wbjf/WB-Admin/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "build:test": "vue-tsc --noEmit && vite build --mode test",
    "build:prod": "vue-tsc --noEmit && vite build --mode production",
    "build:pages": "vue-tsc --noEmit && vite build --mode pages",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,vue,json,md,scss}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "gen": "node code-generator/cli.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:build:pages": "vitepress build docs --outDir dist/docs",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^11.3.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "axios": "^1.7.9",
    "cropperjs": "^1.6.2",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.8",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.10.0",
    "js-cookie": "^3.0.5",
    "md-editor-v3": "^4.20.1",
    "mockjs": "^1.1.0",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.0",
    "pinia-plugin-persistedstate": "^4.2.0",
    "print-js": "^1.6.0",
    "qrcode": "^1.5.4",
    "screenfull": "^6.0.2",
    "sortablejs": "^1.15.6",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.4",
    "vue-router": "^4.4.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.49.1",
    "@types/js-cookie": "^3.0.6",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^22.10.2",
    "@types/nprogress": "^0.2.3",
    "@types/sortablejs": "^1.15.8",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.13.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass": "^1.81.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.17.0",
    "unplugin-auto-import": "^0.18.6",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^6.0.5",
    "vite-plugin-compression": "^0.5.1",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.8",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.1.10"
  },
  "lint-staged": {
    "*.{ts,js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,scss}": [
      "prettier --write"
    ]
  }
}
