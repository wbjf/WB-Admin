# GitHub Pages 线上演示专用配置（静态托管子路径）
#
# 用法：npm run build:pages   → 产出 dist/
#
# 与 .env.production 的关键差别只有两处，都是静态托管的硬约束：
#   1. VITE_BASE_URL 必须带子路径 —— 项目站地址是
#      https://<user>.github.io/<repo>/，不是域名根目录。
#   2. VITE_USE_MOCK 必须开 —— 静态托管没有后端；
#      而 mock 中间件挂在 Vite dev server 上（src/mock/plugin.ts），
#      静态产物里根本不会被加载。所以生产构建开着这个开关时，
#      src/utils/request.ts 会把 axios adapter 换成浏览器内的 mock
#      （src/mock/adapter.ts），前端行为与开发环境一致。

VITE_APP_TITLE=WB-Admin
VITE_APP_ENV=pages

VITE_BASE_URL=/WB-Admin/

VITE_API_PREFIX=/prod-api
VITE_PROXY_TARGET=https://api.example.com
VITE_USE_MOCK=true

VITE_BUILD_COMPRESS=false
VITE_BUILD_ANALYZE=false
VITE_BUILD_SOURCEMAP=false

VITE_ENABLE_I18N=true
VITE_ENABLE_TENANT=true
VITE_ENABLE_DEMO=true
