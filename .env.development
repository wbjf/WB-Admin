# 站点
VITE_APP_TITLE=WB-Admin
VITE_APP_ENV=development
VITE_BASE_URL=/
VITE_PORT=3000

# 接口
VITE_API_PREFIX=/api
VITE_PROXY_TARGET=http://127.0.0.1:8080
VITE_USE_MOCK=true

# AI 对话（Ollama）。vite 会把 /api/chat、/api/tags 转发到这里。
# 模型装在别的机器上就改成那台机器的地址，并让 Ollama 监听 0.0.0.0
VITE_OLLAMA_TARGET=http://127.0.0.1:11434
# 拉不到模型列表时的兜底模型名，必须与服务器上实际存在的一致
VITE_OLLAMA_MODEL=qwen2.5:3b

# 打包
VITE_BUILD_COMPRESS=false
VITE_BUILD_ANALYZE=false
VITE_BUILD_SOURCEMAP=true

# 功能开关
VITE_ENABLE_I18N=true
VITE_ENABLE_TENANT=true
VITE_ENABLE_DEMO=true
